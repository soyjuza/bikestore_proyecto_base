# Copia este archivo como .env.test para correr las pruebas (npm test).
# La base de datos de pruebas se borra y se vuelve a crear en cada corrida,
# por eso el nombre TIENE que terminar en _test: así nunca se borra la de verdad.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bikestore_test

JWT_SECRET=clave-solo-para-las-pruebas-no-usar-en-otro-lado
