NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bikestore

# Clave con la que se firman los tokens. Debe ser larga (mínimo 32 caracteres) y distinta en cada equipo.
# Para generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave
JWT_EXPIRES_IN=2h

# URL del frontend: se usa para armar el enlace de recuperación de contraseña (RF-16)
# y es el único origen que puede llamar a la API desde el navegador (CORS).
FRONTEND_URL=http://localhost:5173

# Correo para enviar el enlace de recuperación (RF-16). Si SMTP_HOST queda vacío,
# el correo no se envía: se imprime en la consola del servidor para poder probar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BikeStore <no-responder@bikestore.co>

# Admin inicial (opcional): si se define, se crea automáticamente al arrancar
# el servidor por primera vez contra una base de datos nueva. Si ya existe un
# usuario con ese email, no se vuelve a crear. Cambie la contraseña antes de mostrar el proyecto.
ADMIN_NAME=Administrador BikeStore
ADMIN_EMAIL=admin@bikestore.co
ADMIN_PASSWORD=admin1234
